NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/unify?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
# Comma-separated browser origins. Native Flutter clients do not send Origin headers.
CORS_ORIGINS="http://localhost:5173"
# Public HTTPS API base URL in production, e.g. https://api.example.com
PUBLIC_BASE_URL=""
# Mount a Railway Volume at this path in production.
UPLOAD_DIR="./uploads"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-smtp-user@example.com"
SMTP_PASSWORD="your-smtp-password-or-app-password"
MAIL_FROM="Unify <your-smtp-user@example.com>"

# Required only for the AI endpoints.
GEMINI_API_KEY=""

# Cloudinary document storage (required for durable resume uploads).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
