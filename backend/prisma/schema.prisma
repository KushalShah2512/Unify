generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  passwordResetToken   String?
  passwordResetExpires DateTime?
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile  StudentProfile?
  employerProfile EmployerProfile?
  notifications   Notification[]
}

model StudentProfile {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique
  fullName     String
  phone        String?
  location     String?
  bio          String?
  education    String?
  careerGoal   String?
  availability String?

  resumeUrl          String?
  resumeName         String?
  resumeSize         Int?
  resumeUpdatedAt    DateTime?
  isResumeVerified   Boolean   @default(false)
  resumeStorageKey   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  skills             Skill[]
  projects           Project[]
  certifications     Certification[]
  educationRecords   Education[]
  applications       Application[]
  savedOpportunities SavedOpportunity[]
  opportunityReports OpportunityReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  level     String?
  studentId Int

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id           Int     @id @default(autoincrement())
  title        String
  description  String?
  technologies String?
  projectUrl   String?
  studentId    Int

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certification {
  id            Int       @id @default(autoincrement())
  name          String
  issuingOrg    String?
  issueDate     DateTime?
  credentialUrl String?
  studentId     Int

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployerProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique
  companyName        String
  description        String?
  industry           String?
  website            String?
  location           String?
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  STUDENT
  EMPLOYER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Education {
  id           Int      @id @default(autoincrement())
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  studentId    Int

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  type            String
  companyName     String
  location        String?
  workMode        String?
  stipend         String?
  salary          String?
  applicationUrl  String?
  requiredSkills  String[]
  preferredSkills String?
  experience      String?
  isActive        Boolean              @default(true)
  applications    Application[]
  savedBy         SavedOpportunity[]
  reports         OpportunityReport[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Application {
  id            Int            @id @default(autoincrement())
  studentId     Int
  opportunityId Int
  status        String         @default("APPLIED")
  coverLetter   String?
  appliedAt     DateTime       @default(now())

  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([studentId, opportunityId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("APPLICATION") // APPLICATION, JOB_MATCH, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedOpportunity {
  id            Int            @id @default(autoincrement())
  studentId     Int
  opportunityId Int
  savedAt       DateTime       @default(now())

  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([studentId, opportunityId])
}

model OpportunityReport {
  id            Int            @id @default(autoincrement())
  opportunityId Int
  studentId     Int
  reason        String
  details       String?
  status        String         @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt     DateTime       @default(now())

  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
